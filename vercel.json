{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/ideas/generate",
      "dest": "/api/ideas/generate.js"
    },
    {
      "src": "/api/ideas/index",
      "dest": "/api/ideas/index.js"
    },
    {
      "src": "/api/ideas/[id]",
      "dest": "/api/ideas/[id].js"
    },
    {
      "src": "/api/trends/index",
      "dest": "/api/trends/index.js"
    },
    {
      "src": "/api/trends/suggest",
      "dest": "/api/trends/suggest.js"
    },
    {
      "src": "/api/cron/fetch-trends",
      "dest": "/api/cron/fetch-trends.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/fetch-trends",
      "schedule": "0 9 * * *"
    }
  ]
}